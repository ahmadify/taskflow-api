  "item": [
    {
      "name": "Implemented Authentication",
      "description": "These requests match the four routes implemented by the Laravel application.",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{registration_name}}\",\n  \"email\": \"{{registration_email}}\",\n  \"password\": \"{{registration_password}}\",\n  \"password_confirmation\": \"{{registration_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/register",
            "description": "Registers a user, returns HTTP 201 with data.user and data.token, and stores the token and user ID in the selected environment. Temporary registration values are generated at runtime."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Registration response contains the user and bearer token', function () {",
                  "    pm.expect(json.message).to.eql('Registration successful.');",
                  "    pm.expect(json).to.have.nested.property('data.user.id');",
                  "    pm.expect(json).to.have.nested.property('data.user.name');",
                  "    pm.expect(json).to.have.nested.property('data.user.email');",
                  "    pm.expect(json).to.have.nested.property('data.token');",
                  "    pm.expect(json.data.token_type).to.eql('Bearer');",
                  "});",
                  "if (pm.response.code === 201 && json.data && json.data.token) {",
                  "    pm.environment.set('token', json.data.token);",
                  "    pm.environment.set('user_id', json.data.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
