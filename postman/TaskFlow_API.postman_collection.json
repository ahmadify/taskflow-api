  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('registration_name')) {",
          "    pm.collectionVariables.set('registration_name', pm.variables.replaceIn('{{$randomFullName}}'));",
          "}",
          "if (!pm.collectionVariables.get('registration_email')) {",
          "    pm.collectionVariables.set('registration_email', pm.variables.replaceIn('{{$randomEmail}}'));",
          "}",
          "if (!pm.collectionVariables.get('registration_password')) {",
          "    pm.collectionVariables.set('registration_password', pm.variables.replaceIn('{{$randomUUID}}'));",
          "}"
        ]
      }
    }
  ],
