              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 422', function () { pm.response.to.have.status(422); });",
                  "var json = pm.response.json();",
                  "pm.test('Required fields are reported', function () {",
                  "    pm.expect(json).to.have.property('message');",
                  "    pm.expect(json.errors).to.have.all.keys('name', 'email', 'password', 'password_confirmation');",
                  "});"
                ]
              }
            }
