              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/login",
            "description": "Authenticates the registered collection user, returns HTTP 200 with data.user and data.token, and stores the token and user ID in the selected environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Login response contains the user and bearer token', function () {",
                  "    pm.expect(json.message).to.eql('Login successful.');",
                  "    pm.expect(json).to.have.nested.property('data.user.id');",
                  "    pm.expect(json).to.have.nested.property('data.user.email');",
                  "    pm.expect(json).to.have.nested.property('data.token');",
                  "    pm.expect(json.data.token_type).to.eql('Bearer');",
                  "});",
                  "if (pm.response.code === 200 && json.data && json.data.token) {",
                  "    pm.environment.set('token', json.data.token);",
                  "    pm.environment.set('user_id', json.data.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/user",
            "description": "Returns HTTP 200 with data.user for the current Sanctum bearer token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Response contains a safe user resource', function () {",
                  "    pm.expect(json).to.have.nested.property('data.user.id');",
                  "    pm.expect(json).to.have.nested.property('data.user.name');",
                  "    pm.expect(json).to.have.nested.property('data.user.email');",
                  "    pm.expect(json.data.user).not.to.have.property('password');",
                  "    pm.expect(json.data.user).not.to.have.property('remember_token');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/logout",
            "description": "Revokes only the Sanctum token used for this request and returns HTTP 200."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Logout response has the expected structure', function () {",
                  "    pm.expect(json.message).to.eql('Logout successful.');",
                  "    pm.expect(json.data).to.eql(null);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set('token', '');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
